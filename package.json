{
	"name": "@noooooooode/libphonenumber-jp",
	"version": "0.1.1",
	"description": "Parse, format and validate Japanese phone numbers with libphonenumber's API, in a fraction of the bundle.",
	"keywords": [
		"libphonenumber",
		"japan",
		"japanese",
		"phone",
		"telephone",
		"parse",
		"validate",
		"format",
		"bundle-size"
	],
	"homepage": "https://github.com/oooooooo/libphonenumber-jp#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oooooooo/libphonenumber-jp.git"
	},
	"bugs": {
		"url": "https://github.com/oooooooo/libphonenumber-jp/issues"
	},
	"author": "oooooooo",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"NOTICE",
		"third_party"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"generate": "node tools/generate.mjs && biome check --write src/data.ts",
		"benchmark": "npm run build && node tools/benchmark.mjs",
		"clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
		"build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"fs.writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "node --test \"test/*.test.ts\"",
		"coverage": "node --test --experimental-test-coverage \"test/*.test.ts\"",
		"prepare": "npm run build",
		"prepublishOnly": "npm run lint && npm run typecheck && npm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^24.10.1",
		"esbuild": "^0.28.2",
		"libphonenumber-js": "^1.13.12",
		"libphonenumber-metadata-generator": "^2.0.6",
		"typescript": "^5.9.3"
	}
}
